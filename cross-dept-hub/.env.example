# --- Required ---------------------------------------------------------------

# Supabase (EU region recommended for GDPR). From your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment (used for OAuth redirects + email links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI features (briefing + document filing) -------------------------------
# Without this key the hub still works fully; only the AI suggestions are off.
ANTHROPIC_API_KEY=

# --- Optional: branding -----------------------------------------------------
# NEXT_PUBLIC_APP_NAME="Cross-Dept"

# --- Optional: live SharePoint filing via Microsoft Graph -------------------
# Either log in with Microsoft SSO (token is stored per user), or set a token
# here for local/dev. Unset: the filing assistant still suggests folders and
# names; only the live upload/move is skipped.
MS_GRAPH_TOKEN=

# --- Optional: email notifications ------------------------------------------
# Provider auto-selected: Resend if RESEND_API_KEY set, else Microsoft Graph
# sendMail if MS_GRAPH_TOKEN set, else email is skipped (in-app + browser
# notifications still work).
RESEND_API_KEY=
PM_EMAIL_FROM="Abteilungs-Hub <no-reply@example.com>"
