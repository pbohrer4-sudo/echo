# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (shared default — users can override in settings)
ANTHROPIC_API_KEY=

# Mistral (used for OCR / business card scanning — users can BYOK in settings)
MISTRAL_API_KEY=

# ElevenLabs (shared default)
ELEVENLABS_API_KEY=

# Microsoft Graph (SharePoint filing for the department hub).
# Injection point for the delegated Graph token from Microsoft Entra SSO
# (scopes: Files.ReadWrite.All, Sites.ReadWrite.All). When unset the filing
# assistant still suggests folders/names from the cached tree; only the
# live upload/move to SharePoint is skipped.
MS_GRAPH_TOKEN=

# Notification email (department hub). Provider is auto-selected: Resend if
# RESEND_API_KEY is set, else Microsoft Graph sendMail if MS_GRAPH_TOKEN is
# set, else email is skipped (in-app + browser notifications still work).
RESEND_API_KEY=
PM_EMAIL_FROM="Abteilungs-Hub <no-reply@example.com>"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
